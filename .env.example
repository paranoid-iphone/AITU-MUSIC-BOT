APP_NAME=AITU Music Club
# "local" accepts a weak INTERNAL_API_TOKEN (dev/tests only). Anything else requires a strong one.
ENVIRONMENT=production

DATABASE_URL=postgresql+asyncpg://aitu:aitu@db:5432/aitu_music
BOT_TOKEN=
BACKEND_BASE_URL=http://backend:8000
WEBAPP_BASE_URL=
NGROK_API_URL=http://ngrok:4040/api/tunnels
NGROK_AUTHTOKEN=
# Required, at least 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
REDIS_URL=redis://redis:6379/0
INITIAL_ADMIN_TELEGRAM_IDS=
REGISTRATION_RETRY_HOURS=24

DEFAULT_LANGUAGE=ru
TIMEZONE=Asia/Almaty

# Default model: sliding 7-day window, first come first served. Set to true for weekly planning instead:
# requests close and the room is allocated every Sunday at ALLOCATION_TIME (TIMEZONE)
WEEKLY_PLANNING_ENABLED=false
ALLOCATION_TIME=18:00

# Database dumps (compose service `backup`, files in ./backups): one every N hours, kept for N days
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Google Sheets backup (leave empty to disable). Share the sheet with the service account e-mail as Editor.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
